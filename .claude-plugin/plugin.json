{
  "$schema": "https://json.schemastore.org/claude-code-plugin.json",
  "name": "timesheet",
  "displayName": "Timesheet",
  "version": "1.3.0",
  "description": "Track time and manage projects, tasks, absences, contracts, expenses, todos, and team data in Timesheet",
  "author": {
    "name": "Timesheet.io",
    "email": "support@timesheet.io",
    "url": "https://timesheet.io"
  },
  "homepage": "https://timesheet.io",
  "repository": "https://github.com/timesheetIO/timesheet-plugin",
  "license": "MIT",
  "icon": "./assets/icon.png",
  "documentationUrl": "https://docs.timesheet.io/integrations/mcp-server/",
  "supportUrl": "https://docs.timesheet.io/troubleshooting/",
  "privacyPolicyUrl": "https://timesheet.io/en/privacy",
  "termsOfServiceUrl": "https://timesheet.io/en/terms",
  "keywords": [
    "timesheet",
    "time-tracking",
    "timer",
    "projects",
    "absences",
    "expenses",
    "productivity",
    "mcp",
    "cli"
  ],
  "userConfig": {
    "session_reminders": {
      "type": "boolean",
      "title": "Session reminders",
      "description": "Note when each Claude Code session starts, and remind you at the next start when the last session in the same folder ran 15 minutes or more without any time logged.",
      "default": true
    }
  }
}
